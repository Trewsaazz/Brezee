<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Brezee.App</RootNamespace>
    <AssemblyName>Brezee</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    The Strings class (Brezee.App.Resources.Strings) is generated from Resources\Strings.resx at build
    time, so no designer file is checked in and the resx can be edited in any editor.
    It is generated before XAML compilation and included as a normal Compile item, so WPF's temporary
    markup-compilation project can also resolve {x:Static res:Strings.*}.
  -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)Strings.g.cs" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateStringsClass"
          BeforeTargets="MarkupCompilePass1;CoreCompile"
          Inputs="Resources\Strings.resx"
          Outputs="$(IntermediateOutputPath)Strings.g.cs">
    <GenerateResource Sources="Resources\Strings.resx"
                      OutputResources="$(IntermediateOutputPath)Strings.codegen.resources"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="Brezee.App.Resources"
                      StronglyTypedClassName="Strings"
                      StronglyTypedManifestPrefix="Brezee.App.Resources"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs"
                      PublicClass="true"
                      ExecuteAsTool="false" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brezee.Bridge\Brezee.Bridge.vcxproj" />
  </ItemGroup>

</Project>
