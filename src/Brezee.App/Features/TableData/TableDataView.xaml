<UserControl x:Class="Brezee.App.Features.TableData.TableDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Brezee.App.Features.TableData"
             xmlns:connect="clr-namespace:Brezee.App.Features.Connect"
             xmlns:res="clr-namespace:Brezee.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:TableDataViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Filter bar -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6">
            <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                   Target="{Binding ElementName=FilterBox}" Content="{x:Static res:Strings.TableData_Filter}" />
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,2"
                    Content="{x:Static res:Strings.Command_Refresh}" Command="{Binding RefreshCommand}" />
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,2"
                    Content="{x:Static res:Strings.TableData_Apply}" Command="{Binding ApplyFilterCommand}" />
            <TextBox x:Name="FilterBox" Padding="4,2" FontFamily="Cascadia Mono, Consolas, Courier New"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{x:Static res:Strings.TableData_FilterHint}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyFilterCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Margin="8,0,8,6" Foreground="Firebrick" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={x:Static connect:NotEmptyToVisibilityConverter.Instance}}" />

        <!-- Status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="Gray" Text="{Binding StatusText}" />
            <ProgressBar DockPanel.Dock="Left" Width="100" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Padding="10,2"
                    Content="{x:Static res:Strings.TableData_LoadMore}" Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMoreRows, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <!-- Columns are created in code from the result (see TableDataView.xaml.cs). -->
        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  HeadersVisibility="All"
                  GridLinesVisibility="Vertical"
                  VerticalGridLinesBrush="#E0E0E0"
                  AlternatingRowBackground="#FAFAFA"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  FontFamily="Segoe UI"
                  Sorting="OnSorting" />
    </DockPanel>
</UserControl>
