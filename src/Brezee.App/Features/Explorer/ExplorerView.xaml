<UserControl x:Class="Brezee.App.Features.Explorer.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Brezee.App.Features.Explorer"
             xmlns:res="clr-namespace:Brezee.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ExplorerViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Context menus. Their DataContext is the node; commands on the explorer come through
             PlacementTarget.Tag, which each template sets to the explorer view model. -->
        <ContextMenu x:Key="DatabaseMenu">
            <MenuItem Header="{x:Static res:Strings.Command_Connect}"
                      Command="{Binding PlacementTarget.Tag.ConnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static res:Strings.Command_Disconnect}"
                      Command="{Binding PlacementTarget.Tag.DisconnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.Command_ForgetPassword}"
                      Command="{Binding PlacementTarget.Tag.ForgetPasswordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static res:Strings.Command_RemoveSaved}"
                      Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>

        <ContextMenu x:Key="ObjectMenu">
            <MenuItem Header="{x:Static res:Strings.Command_OpenData}"
                      Command="{Binding PlacementTarget.Tag.OpenDataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}" />
        </ContextMenu>

        <ContextMenu x:Key="FolderMenu">
            <MenuItem Header="{x:Static res:Strings.Command_Refresh}" Command="{Binding LoadCommand}" />
        </ContextMenu>

        <!-- A database: green dot while connected, hollow ring otherwise. -->
        <HierarchicalDataTemplate DataType="{x:Type local:DatabaseNodeViewModel}" ItemsSource="{Binding Children}">
            <DockPanel Margin="0,2" ToolTip="{Binding Details}" ContextMenu="{StaticResource DatabaseMenu}"
                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,6,0"
                         VerticalAlignment="Top" Stroke="Gray" StrokeThickness="1" />
                <StackPanel>
                    <TextBlock x:Name="NameText" Text="{Binding Name}" />
                    <TextBlock Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Location, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Status, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="#2EA44F" />
                    <Setter TargetName="Dot" Property="Stroke" Value="#2EA44F" />
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- A folder of objects, with the count once loaded. -->
        <HierarchicalDataTemplate DataType="{x:Type local:ObjectFolderNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1" ContextMenu="{StaticResource FolderMenu}">
                <TextBlock Text="{Binding Title}" />
                <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" Foreground="Gray" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- An object; triggers and indices also show their table. -->
        <DataTemplate DataType="{x:Type local:ObjectNode}">
            <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Description}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="True">
                                <Setter Property="ContextMenu" Value="{StaticResource ObjectMenu}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock x:Name="NameText" Text="{Binding Name}" />
                <TextBlock Text="{Binding Parent}" Margin="6,0,0,0" Foreground="Gray"
                           Visibility="{Binding HasParent, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding FlagsText}" Margin="6,0,0,0" Foreground="Gray" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="Gray" />
                    <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:MessageNode}">
            <TextBlock x:Name="MessageText" Text="{Binding Text}" Foreground="Gray" FontStyle="Italic"
                       TextWrapping="Wrap" MaxWidth="320" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="MessageText" Property="Foreground" Value="Firebrick" />
                    <Setter TargetName="MessageText" Property="FontStyle" Value="Normal" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TextBlock Text="{x:Static res:Strings.Explorer_NoConnections}"
                   Foreground="Gray"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDatabases}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TreeView x:Name="Tree"
                  ItemsSource="{Binding Databases}"
                  BorderThickness="0"
                  SelectedItemChanged="OnSelectedItemChanged"
                  MouseDoubleClick="OnMouseDoubleClick"
                  Visibility="{Binding HasDatabases, Converter={StaticResource BoolToVisibility}}">
            <TreeView.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
            </TreeView.InputBindings>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
