<UserControl x:Class="Brezee.App.Features.Welcome.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Brezee.App.Resources">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{x:Static res:Strings.App_Name}"
                       FontSize="40" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.App_Tagline}"
                       Margin="0,4,0,0"
                       FontSize="16"
                       HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0"
                       FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Center"
                       Text="{Binding CoreVersion, StringFormat={x:Static res:Strings.App_CoreVersion}}" />
        </StackPanel>
    </Grid>
</UserControl>
