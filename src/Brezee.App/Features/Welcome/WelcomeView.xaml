<UserControl x:Class="Brezee.App.Features.Welcome.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Brezee.App.Features.Welcome"
             xmlns:res="clr-namespace:Brezee.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:WelcomeViewModel}">
    <UserControl.Resources>
        <!-- A button that looks like a link. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#0B63CE" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#084A9A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,40" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Strings.App_Name}" FontSize="40" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static res:Strings.App_Tagline}" Margin="0,4,0,0" FontSize="16" Foreground="#555" />

            <Button Style="{StaticResource LinkButton}" Margin="0,32,0,0" FontSize="15"
                    Command="{Binding ConnectCommand}">
                <TextBlock Text="{x:Static res:Strings.Welcome_Connect}" />
            </Button>

            <TextBlock Text="{x:Static res:Strings.Welcome_Recent}" Margin="0,32,0,8" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Recent.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LinkButton}" Margin="0,4"
                                ToolTip="{Binding Database}"
                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" />
                                <Run Text="{Binding Location, Mode=OneWay}" Foreground="Gray" />
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Static res:Strings.Welcome_NoRecent}" Foreground="Gray">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Recent.Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Margin="0,40,0,0" FontSize="11" Foreground="Gray"
                       Text="{Binding CoreVersion, StringFormat={x:Static res:Strings.App_CoreVersion}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
