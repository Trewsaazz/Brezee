<UserControl x:Class="Brezee.App.Features.Welcome.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Brezee"
                       FontSize="40" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="A modern desktop client for Firebird SQL"
                       Margin="0,4,0,0"
                       FontSize="16"
                       HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0"
                       FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Center"
                       Text="{Binding CoreVersion, StringFormat='Core v{0}'}" />
        </StackPanel>
    </Grid>
</UserControl>
