<Window x:Class="Brezee.App.Features.Connect.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Brezee.App.Features.Connect"
        xmlns:res="clr-namespace:Brezee.App.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ConnectDialogViewModel}"
        Title="{x:Static res:Strings.Connect_Title}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=DatabaseBox}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                    IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBooleanConverter.Instance}}">
            <RadioButton Margin="0,0,20,0"
                         Content="{x:Static res:Strings.Connect_ModeServer}"
                         IsChecked="{Binding IsLocal, Converter={x:Static local:InverseBooleanConverter.Instance}}" />
            <RadioButton Content="{x:Static res:Strings.Connect_ModeLocal}"
                         IsChecked="{Binding IsLocal}" />
        </StackPanel>

        <Grid IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBooleanConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Server and port only apply to server connections. -->
            <Label Grid.Row="0" Target="{Binding ElementName=HostBox}" Content="{x:Static res:Strings.Connect_Server}"
                   Visibility="{Binding IsLocal, Converter={x:Static local:TrueToCollapsedConverter.Instance}}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsLocal, Converter={x:Static local:TrueToCollapsedConverter.Instance}}" />
            <Label Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" Target="{Binding ElementName=PortBox}" Content="{x:Static res:Strings.Connect_Port}"
                   Visibility="{Binding IsLocal, Converter={x:Static local:TrueToCollapsedConverter.Instance}}" />
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsLocal, Converter={x:Static local:TrueToCollapsedConverter.Instance}}" />

            <Label Grid.Row="1" Target="{Binding ElementName=DatabaseBox}" Content="{x:Static res:Strings.Connect_Database}" />
            <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                <Button DockPanel.Dock="Right" Margin="8,4,0,4" Padding="10,0"
                        Content="{x:Static res:Strings.Connect_Browse}"
                        Click="OnBrowse"
                        Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}" />
                <TextBox x:Name="DatabaseBox" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Text="{x:Static res:Strings.Connect_DatabaseHint}"
                       Visibility="{Binding IsLocal, Converter={x:Static local:TrueToCollapsedConverter.Instance}}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Text="{x:Static res:Strings.Connect_LocalDatabaseHint}"
                       Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}" />

            <Label Grid.Row="3" Target="{Binding ElementName=UserBox}" Content="{x:Static res:Strings.Connect_User}" />
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="UserBox" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="4" Target="{Binding ElementName=PasswordBox}" Content="{x:Static res:Strings.Connect_Password}" />
            <PasswordBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />

            <Label Grid.Row="5" Target="{Binding ElementName=RoleBox}" Content="{x:Static res:Strings.Connect_Role}" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="RoleBox" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="5" Grid.Column="2" Margin="12,0,0,0" Target="{Binding ElementName=CharsetBox}" Content="{x:Static res:Strings.Connect_Charset}" />
            <TextBox Grid.Row="5" Grid.Column="3" x:Name="CharsetBox" Text="{Binding Charset, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock Margin="0,12,0,0"
                   Foreground="Firebrick"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={x:Static local:NotEmptyToVisibilityConverter.Instance}}" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" MinWidth="88" Margin="8,0,0,0" IsCancel="True"
                    IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBooleanConverter.Instance}}"
                    Content="{x:Static res:Strings.Common_Cancel}" />
            <Button DockPanel.Dock="Right" MinWidth="88" IsDefault="True"
                    Command="{Binding ConnectCommand}"
                    Content="{x:Static res:Strings.Connect_Connect}" />
        </DockPanel>
    </StackPanel>
</Window>
