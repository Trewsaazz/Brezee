<Window x:Class="Brezee.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:avalonDockThemes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:shell="clr-namespace:Brezee.App.Shell"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance shell:ShellViewModel}"
        Title="Brezee"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Ready" />
            <StatusBarItem HorizontalAlignment="Right"
                           Content="{Binding CoreVersion}"
                           ContentStringFormat="Core v{0}" />
        </StatusBar>

        <avalonDock:DockingManager AnchorablesSource="{Binding Tools}"
                                   DocumentsSource="{Binding Documents}"
                                   ActiveContent="{Binding ActiveDocument, Mode=TwoWay, Converter={x:Static shell:ActiveDocumentConverter.Instance}}">

            <avalonDock:DockingManager.Theme>
                <avalonDockThemes:Vs2013LightTheme />
            </avalonDock:DockingManager.Theme>

            <avalonDock:DockingManager.LayoutUpdateStrategy>
                <shell:ToolLayoutStrategy />
            </avalonDock:DockingManager.LayoutUpdateStrategy>

            <avalonDock:DockingManager.LayoutItemContainerStyleSelector>
                <shell:PaneStyleSelector>
                    <shell:PaneStyleSelector.ToolStyle>
                        <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}" />
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                            <Setter Property="CanClose" Value="False" />
                        </Style>
                    </shell:PaneStyleSelector.ToolStyle>
                    <shell:PaneStyleSelector.DocumentStyle>
                        <Style TargetType="{x:Type avalonDockControls:LayoutDocumentItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}" />
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                            <Setter Property="CloseCommand" Value="{Binding Model.CloseCommand}" />
                        </Style>
                    </shell:PaneStyleSelector.DocumentStyle>
                </shell:PaneStyleSelector>
            </avalonDock:DockingManager.LayoutItemContainerStyleSelector>

            <!-- Layout skeleton. ToolLayoutStrategy drops each tool into its named pane. -->
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePane Name="LeftToolPane" DockWidth="280" />
                    <avalonDock:LayoutPanel Orientation="Vertical">
                        <avalonDock:LayoutDocumentPane />
                        <avalonDock:LayoutAnchorablePane Name="BottomToolPane" DockHeight="180" />
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </DockPanel>
</Window>
